<script>
(function(){
  var WORDS_RAW = __WORDS_JSON__;
  var ITEMS = WORDS_RAW.map(function(w){ return { unit:w.u, word:w.t, meaning:w.m, sentence:w.e }; });
  var UNITS = [];
  ITEMS.forEach(function(w){ if (UNITS.indexOf(w.unit) === -1) UNITS.push(w.unit); });
  function unitLabel(u){ return u.indexOf('Special Reading') === 0 ? u.replace('Special ', '') : u; }
  var PASS = 0.8;

  /* ---- Google Form (same form as 멍멍 발음 친구) ---- */
  var FORM = {
    baseUrl:'https://docs.google.com/forms/d/e/1FAIpQLScO37vlswQSm6N-mqx1w5VrYeCnsao1JVlK-WqzJME82imV-A/viewform',
    nameEntry:'entry.1598372142', scoreEntry:'entry.1041762124'
  };
  function formUrl(name, score){
    return FORM.baseUrl + '?usp=pp_url&' + FORM.nameEntry + '=' + encodeURIComponent(name) + '&' + FORM.scoreEntry + '=' + encodeURIComponent(score);
  }

  /* ---- sounds Korean learners find tricky ---- */
  var SOUNDS = {
    th:{label:'th', ko:'θ/ð', tip:'<b>th</b> · 혀끝을 윗니와 아랫니 사이에 살짝 내밀고 바람을 내보내요. ㅆ(sank)이나 ㄷ(dat)로 바뀌지 않게! 예) <b>th</b>ank, <b>th</b>e'},
    f:{label:'f', ko:'ㅍ 아님', tip:'<b>f</b> · 윗니를 아랫입술에 살짝 대고 바람을 \'ffff\' 흘려보내요. 두 입술을 붙이면 ㅍ(p)가 돼요. 예) <b>f</b>ood, cou<b>gh</b>'},
    v:{label:'v', ko:'ㅂ 아님', tip:'<b>v</b> · f와 같은 입 모양에서 목을 울려요(목에 손을 대면 떨려요). 입술을 붙이면 ㅂ(b)가 돼요. 예) <b>v</b>ery, o<b>f</b>'},
    r:{label:'r', ko:'혀 말기', tip:'<b>r</b> · 혀끝을 입천장 어디에도 닿지 않게 살짝 뒤로 말고, 입술을 조금 둥글게 해요. 단어 끝 r도 살려요. 예) <b>r</b>ice, ca<b>r</b>'},
    l:{label:'l', ko:'혀 붙이기', tip:'<b>l</b> · 혀끝을 윗니 뒤 잇몸에 꾹 붙이고 소리 내요. 단어 끝 l(school)은 혀를 붙인 채로 끝내요. 예) <b>l</b>ight, coo<b>l</b>'}
  };
  var SOUND_ORDER = ['th','f','v','r','l'];
  var SILENT_L = ['could','would','should','half','calm','walk','talk','chalk','palm','folk','salmon'];
  var GH_F = ['laugh','laughed','laughing','laughs','enough','tough','rough','cough'];

  /* returns [{start,end,sound}] over the lowercase word */
  function findSounds(word){
    var w = word.toLowerCase(), out = [], used = {};
    function mark(s,e,snd){ for (var k=s;k<e;k++){ if (used[k]) return; } for (var k2=s;k2<e;k2++) used[k2]=1; out.push({start:s,end:e,sound:snd}); }
    var bare = w.replace(/[^a-z']/g,'');
    var i;
    for (i=0;i<w.length-1;i++){ if (w.substr(i,2)==='th') mark(i,i+2,'th'); }
    for (i=0;i<w.length-1;i++){ if (w.substr(i,2)==='ph') mark(i,i+2,'f'); }
    if (GH_F.indexOf(bare) !== -1){ var g = w.indexOf('gh'); if (g>=0) mark(g,g+2,'f'); }
    for (i=0;i<w.length;i++){
      var c = w[i];
      if (c==='f') mark(i,i+1, bare==='of' ? 'v' : 'f');
      else if (c==='v') mark(i,i+1,'v');
      else if (c==='r') mark(i,i+1,'r');
      else if (c==='l' && SILENT_L.indexOf(bare)===-1) mark(i,i+1,'l');
    }
    out.sort(function(a,b){ return a.start-b.start; });
    return out;
  }

  /* ---- text normalization & alignment ---- */
  var NUMWORDS = {'0':'zero','1':'one','2':'two','3':'three','4':'four','5':'five','6':'six','7':'seven','8':'eight','9':'nine','10':'ten'};
  function normTokens(s){
    s = (s||'').toLowerCase().replace(/[‘’]/g,"'").replace(/(\d),(\d)/g,'$1$2').replace(/-/g,' ');
    s = s.replace(/[^a-z0-9' ]/g,' ').replace(/\s+/g,' ').trim();
    if (!s) return [];
    return s.split(' ').map(function(t){ return t.replace(/^'+|'+$/g,''); }).filter(Boolean);
  }
  function isFree(t){ return /^\d+$/.test(t) || t === 'noeul'; }
  function same(a,b){
    if (a===b) return true;
    var a2=a.replace(/'/g,''), b2=b.replace(/'/g,'');
    if (a2===b2) return true;
    if (NUMWORDS[a]===b || NUMWORDS[b]===a) return true;
    if ((a==='ok'&&b==='okay')||(a==='okay'&&b==='ok')) return true;
    return false;
  }
  /* target tokens t[], heard tokens h[] -> boolean[] matched for each t */
  function align(t,h){
    var n=t.length, m=h.length, dp=[], i, j;
    for (i=0;i<=n;i++){ dp.push(new Array(m+1).fill(0)); }
    for (i=1;i<=n;i++) for (j=1;j<=m;j++){
      var best = Math.max(dp[i-1][j], dp[i][j-1]);
      if (same(t[i-1],h[j-1])) best = Math.max(best, dp[i-1][j-1]+1);
      if (j>=2 && same(t[i-1], h[j-2]+h[j-1])) best = Math.max(best, dp[i-1][j-2]+1);
      if (i>=2 && same(t[i-2]+t[i-1], h[j-1])) best = Math.max(best, dp[i-2][j-1]+2);
      dp[i][j]=best;
    }
    var matched = new Array(n).fill(false);
    i=n; j=m;
    while (i>0 && j>0){
      if (same(t[i-1],h[j-1]) && dp[i][j]===dp[i-1][j-1]+1){ matched[i-1]=true; i--; j--; }
      else if (j>=2 && same(t[i-1],h[j-2]+h[j-1]) && dp[i][j]===dp[i-1][j-2]+1){ matched[i-1]=true; i--; j-=2; }
      else if (i>=2 && same(t[i-2]+t[i-1],h[j-1]) && dp[i][j]===dp[i-2][j-1]+2){ matched[i-1]=matched[i-2]=true; i-=2; j--; }
      else if (dp[i][j]===dp[i-1][j]) i--;
      else j--;
    }
    return matched;
  }

  /* build display model for a sentence */
  function buildSentence(item){
    var words = item.sentence.split(/\s+/).filter(Boolean);
    var flat = [];
    var disp = words.map(function(w, di){
      var toks = normTokens(w);
      var idx = toks.map(function(t){ flat.push({t:t, d:di, free:isFree(t)}); return flat.length-1; });
      return { raw:w, toks:idx, sounds:findSounds(w), target:false };
    });
    markTarget(disp, item.word);
    return { disp:disp, flat:flat };
  }
  var POSS = ['my','your','his','her','its','our','their'];
  function wordMatch(tw, dw){
    if (tw==='~' || tw==='…') return true;
    if (tw==="one's") return POSS.indexOf(dw)!==-1;
    if (tw.length < 3) return tw===dw;
    var stem = tw.slice(0, Math.max(3, tw.length-2));
    return dw.indexOf(stem)===0;
  }
  function markTarget(disp, phrase){
    var tw = phrase.toLowerCase().replace(/[’]/g,"'").replace(/-/g,'').split(/\s+/).filter(Boolean);
    var dws = disp.map(function(d){ return d.raw.toLowerCase().replace(/[’]/g,"'").replace(/[^a-z']/g,''); });
    for (var s=0; s<=dws.length-tw.length; s++){
      var ok = true;
      for (var k=0;k<tw.length;k++){ if (!wordMatch(tw[k], dws[s+k])){ ok=false; break; } }
      if (ok){ for (var k2=0;k2<tw.length;k2++) disp[s+k2].target = true; return; }
    }
    tw.forEach(function(t){
      if (t.length<4 || t==='~' || t==='…') return;
      dws.forEach(function(d,i){ if (wordMatch(t,d)) disp[i].target = true; });
    });
  }

  /* ---- state ---- */
  var state = { name:'', unit:'', items:[], index:0, model:null, activeSound:'', results:{}, listening:false, mode:'sentence', miniWord:'', miniEl:null, rate:0.95 };

  var $ = function(id){ return document.getElementById(id); };
  var els = {
    studentLabel:$('studentLabel'), score:$('scoreDisplay'), pondView:$('pondView'), stones:$('stonesContainer'), practiceView:$('practiceView'),
    progCurrent:$('progressCurrent'), progTotal:$('progressTotal'), progFill:$('progressFill'),
    bubble:$('speechBubble'), dog:$('dogWrap'), confetti:$('confettiLayer'),
    unitBadge:$('unitBadge'), targetWord:$('targetWord'), targetMeaning:$('targetMeaning'), sentence:$('sentence'),
    listenBtn:$('listenBtn'), slowBtn:$('slowBtn'), soundsBox:$('soundsBox'), chips:$('chips'), tip:$('tip'),
    micBtn:$('micBtn'), micLabel:$('micLabel'), live:$('liveText'), hint:$('hintText'),
    feedback:$('feedback'), meter:$('meter'), verdict:$('verdict'), heard:$('heardText'), missList:$('missList'),
    retryBtn:$('retryBtn'), nextBtn:$('nextBtn'), unsupported:$('unsupportedBox'),
    nameOverlay:$('nameOverlay'), nameInput:$('nameInput'), startBtn:$('startBtn'),
    overlay:$('celebrateOverlay'), celebrateName:$('celebrateName'), celebrateScore:$('celebrateScore'), celebrateSub:$('celebrateSub'),
    recordLink:$('recordLink'), anotherUnitBtn:$('anotherUnitBtn'), restartBtn:$('restartBtn')
  };
  els.practiceView.hidden = true;

  /* ---- dog ---- */
  function setDog(s){ els.dog.setAttribute('data-state', s); var face = s==='listening'?'listening':s; ['normal','happy','listening','confused'].forEach(function(n){ var e=els.dog.querySelector('.eyes-'+n); if(e) e.hidden = n!==(face==='idle'?'normal':face); var m=els.dog.querySelector('.mouth-'+n); if(m) m.hidden = n!==(face==='happy'?'happy':face==='confused'?'confused':'normal'); }); }
  function confetti(){
    var colors=['#FF9A4D','#4FB6E0','#3FAE68','#FFD166','#EF476F'];
    for (var i=0;i<16;i++){ var p=document.createElement('span'); p.className='confetti-piece'; var a=Math.random()*Math.PI*2, d=50+Math.random()*60;
      p.style.setProperty('--dx',Math.cos(a)*d+'px'); p.style.setProperty('--dy',(Math.sin(a)*d-30)+'px'); p.style.setProperty('--rot',(Math.random()*360)+'deg');
      p.style.background=colors[i%5]; p.style.animation='confettiFly .9s ease-out forwards'; els.confetti.appendChild(p);
      (function(n){ setTimeout(function(){ n.remove(); },1100); })(p); }
  }

  /* ---- TTS ---- */
  var synth = window.speechSynthesis;
  var voice = null;
  function pickVoice(){
    if (!synth) return;
    var vs = synth.getVoices();
    voice = vs.filter(function(v){ return /en[-_]US/i.test(v.lang) && /Google|Samantha|Aria|Jenny/i.test(v.name); })[0] || vs.filter(function(v){ return /en[-_]US/i.test(v.lang); })[0] || vs.filter(function(v){ return /^en/i.test(v.lang); })[0] || null;
  }
  if (synth){ pickVoice(); if (synth.onvoiceschanged !== undefined) synth.onvoiceschanged = pickVoice; }
  function speak(text, rate, el){
    if (!synth){ els.hint.textContent = '이 브라우저는 듣기 기능을 지원하지 않아요.'; return; }
    synth.cancel();
    var u = new SpeechSynthesisUtterance(text);
    u.lang = 'en-US'; u.rate = rate || 0.95; if (voice) u.voice = voice;
    if (el){ el.classList.add('speaking'); u.onend = u.onerror = function(){ el.classList.remove('speaking'); }; }
    synth.speak(u);
  }

  /* ---- render ---- */
  function escapeHtml(s){ return s.replace(/[&<>"]/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function wordHtml(d){
    var html='', pos=0, w=d.raw;
    d.sounds.forEach(function(s){
      if (state.activeSound !== s.sound) return;
      html += escapeHtml(w.slice(pos,s.start)) + '<span class="hl hl-'+s.sound+'">'+escapeHtml(w.slice(s.start,s.end))+'</span>';
      pos = s.end;
    });
    return html + escapeHtml(w.slice(pos));
  }
  function renderSentence(matchedFlat){
    var m = state.model;
    els.sentence.innerHTML = '';
    m.disp.forEach(function(d){
      var b = document.createElement('button');
      b.type='button'; b.className='tok' + (d.target?' target':'');
      if (matchedFlat){
        var real = d.toks.filter(function(k){ return !m.flat[k].free; });
        if (!real.length && d.toks.length) b.classList.add('free');
        else if (real.length){ b.classList.add(real.every(function(k){ return matchedFlat[k]; }) ? 'ok' : 'miss'); }
      }
      b.innerHTML = wordHtml(d);
      b.setAttribute('aria-label', d.raw.replace(/[^A-Za-z0-9'’ -]/g,'') + ' 듣기');
      b.addEventListener('click', function(){ speak(d.raw.replace(/[^A-Za-z0-9'’ -]/g,''), 0.8, b); });
      els.sentence.appendChild(b);
    });
  }
  function soundsInSentence(){
    var counts = {};
    state.model.disp.forEach(function(d){ d.sounds.forEach(function(s){ counts[s.sound]=(counts[s.sound]||0)+1; }); });
    return counts;
  }
  function renderChips(){
    var counts = soundsInSentence();
    els.chips.innerHTML='';
    var present = SOUND_ORDER.filter(function(s){ return counts[s]; });
    els.soundsBox.hidden = !present.length;
    present.forEach(function(s){
      var b=document.createElement('button'); b.type='button'; b.className='chip chip-'+s;
      b.setAttribute('aria-pressed', state.activeSound===s ? 'true':'false');
      b.innerHTML = SOUNDS[s].label + '<span>' + SOUNDS[s].ko + ' · ' + counts[s] + '</span>';
      b.addEventListener('click', function(){ state.activeSound = (state.activeSound===s ? '' : s); renderChips(); renderSentence(state.lastMatched); });
      els.chips.appendChild(b);
    });
    els.tip.innerHTML = state.activeSound ? SOUNDS[state.activeSound].tip : '위 소리를 누르면 문장에서 그 소리가 나는 글자가 색칠돼요.';
  }
  function defaultSound(){
    var tgt = state.model.disp.filter(function(d){ return d.target; });
    for (var i=0;i<SOUND_ORDER.length;i++){ var s=SOUND_ORDER[i]; if (tgt.some(function(d){ return d.sounds.some(function(x){ return x.sound===s; }); })) return s; }
    var c = soundsInSentence();
    for (var j=0;j<SOUND_ORDER.length;j++){ if (c[SOUND_ORDER[j]]) return SOUND_ORDER[j]; }
    return '';
  }

  function updateScore(){
    var passed = Object.keys(state.results).filter(function(k){ return state.results[k].pass; }).length;
    els.score.textContent = '성공 ' + passed + '문장';
  }
  function loadItem(i){
    state.index = i;
    var it = state.items[i];
    state.model = buildSentence(it);
    state.lastMatched = null;
    state.activeSound = defaultSound();
    state.mode = 'sentence';
    els.unitBadge.textContent = unitLabel(it.unit);
    els.targetWord.textContent = it.word;
    els.targetMeaning.textContent = it.meaning;
    renderSentence(null); renderChips();
    els.feedback.hidden = true; els.live.textContent = '';
    els.bubble.textContent = '먼저 🔊 들어보고, 문장 전체를 나한테 말해줘!';
    setDog('idle');
